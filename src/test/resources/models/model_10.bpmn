<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_merge_split" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.45.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.22.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Merge Split Test" processRef="Process_merge_split" />
  </bpmn:collaboration>
  <bpmn:process id="Process_merge_split" name="Merge Split Test" isExecutable="false" camunda:versionTag="1.0.0">
    <bpmn:extensionElements>
      <camunda:properties>
        <camunda:property name="process_type" value="TEST" />
        <camunda:property name="process_subtype" value="MS" />
      </camunda:properties>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_SC" name="Shop Clerk">
        <bpmn:extensionElements>
          <camunda:properties>
            <camunda:property name="stage" value="SC" />
          </camunda:properties>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_receive_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_order_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_calm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="process_status" value="NEW" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_start_to_receive</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_receive_order" name="Receive Order">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="stage" value="SC" />
          <camunda:property name="activity" value="RCV" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_to_receive</bpmn:incoming>
      <bpmn:outgoing>Flow_receive_to_gw</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_order_valid" name="Order valid?">
      <bpmn:incoming>Flow_receive_to_gw</bpmn:incoming>
      <bpmn:incoming>Flow_calm_to_gw</bpmn:incoming>
      <bpmn:outgoing>Flow_needs_attention</bpmn:outgoing>
      <bpmn:outgoing>Flow_confirmed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_calm" name="Call to Customer">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="stage" value="SC" />
          <camunda:property name="activity" value="CLM" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_needs_attention</bpmn:incoming>
      <bpmn:outgoing>Flow_calm_to_gw</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_start_to_receive" sourceRef="StartEvent_1" targetRef="Task_receive_order" />
    <bpmn:sequenceFlow id="Flow_receive_to_gw" sourceRef="Task_receive_order" targetRef="Gateway_order_valid" />
    <bpmn:sequenceFlow id="Flow_calm_to_gw" sourceRef="Task_calm" targetRef="Gateway_order_valid" />
    <bpmn:sequenceFlow id="Flow_needs_attention" name="Needs attention" sourceRef="Gateway_order_valid" targetRef="Task_calm">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="conclusion" value="NEEDS_ATTENTION" />
          <camunda:property name="process_status" value="PENDING" />
        </camunda:properties>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_confirmed" name="Order confirmed" sourceRef="Gateway_order_valid" targetRef="EndEvent_done">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="conclusion" value="ORDER_CONFIRMED" />
          <camunda:property name="process_status" value="IN_PREPARATION" />
        </camunda:properties>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="EndEvent_done" name="Done">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="process_status" value="CLOSED" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_confirmed</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="130" y="80" width="740" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_SC_di" bpmnElement="Lane_SC" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="710" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="212" y="187" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="218" y="230" width="25" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_receive_order_di" bpmnElement="Task_receive_order">
        <dc:Bounds x="300" y="165" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_order_valid_di" bpmnElement="Gateway_order_valid" isMarkerVisible="true">
        <dc:Bounds x="465" y="180" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="448" y="150" width="65" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_calm_di" bpmnElement="Task_calm">
        <dc:Bounds x="620" y="165" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_done_di" bpmnElement="EndEvent_done">
        <dc:Bounds x="472" y="292" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="477" y="335" width="27" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_start_to_receive_di" bpmnElement="Flow_start_to_receive">
        <di:waypoint x="248" y="205" />
        <di:waypoint x="300" y="205" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_receive_to_gw_di" bpmnElement="Flow_receive_to_gw">
        <di:waypoint x="400" y="205" />
        <di:waypoint x="465" y="205" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_calm_to_gw_di" bpmnElement="Flow_calm_to_gw">
        <di:waypoint x="670" y="165" />
        <di:waypoint x="670" y="130" />
        <di:waypoint x="490" y="130" />
        <di:waypoint x="490" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_needs_attention_di" bpmnElement="Flow_needs_attention">
        <di:waypoint x="515" y="205" />
        <di:waypoint x="620" y="205" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="530" y="215" width="77" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_confirmed_di" bpmnElement="Flow_confirmed">
        <di:waypoint x="490" y="230" />
        <di:waypoint x="490" y="292" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="403" y="249" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
